# Data (too large for git - host on Google Drive / HuggingFace)
# Ignore data/ contents but keep the small split lists and README tracked,
# so the fixed train/val/test partitions ship with the code (reproducibility).
data/*
!data/splits/
!data/README.md
*.pkl

# Model checkpoints (contents only, so checkpoints/README.md stays tracked)
checkpoints/*
*.pth

# Output / results
results/*
!results/table5_rescore.csv
!results/table5_rescore.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.eggs/
*.egg

# Jupyter
.ipynb_checkpoints/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# IDE / tools

# Working files
*.docx
*.png
*.txt
!requirements.txt
!README.md
!data/splits/*.txt
!checkpoints/README.md
!data/README.md
!Output/*.png

